    {
        "id": "login_query_fn",
        "type": "function",
        "z": "6ec25d0a238955d6",
        "name": "Prepare Login Query",
        "func": "const username = ((msg.payload && msg.payload.username) || '').trim();\nconst password = (msg.payload && msg.payload.password) || '';\n\nif (!username || !password) {\n    msg.statusCode = 400;\n    msg.payload = { error: 'Username dan password wajib diisi' };\n    return [null, msg];\n}\n\n// Simpan password mentah sementara di msg (tidak pernah disimpan ke DB/log) untuk diverifikasi setelah baris user didapat\nmsg.loginPassword = password;\nmsg.query = 'SELECT username, password_hash, role FROM users WHERE username = $1;';\nmsg.params = [username];\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
