    {
        "id": "login_user_pg",
        "type": "postgresql",
        "z": "6ec25d0a238955d6",
        "name": "Get User By Username",
        "query": "db",
        "postgreSQLConfig": "f7f72ff7bfaa5606",
        "split": false,
        "rowsPerMsg": 1,
        "outputs": 1,
