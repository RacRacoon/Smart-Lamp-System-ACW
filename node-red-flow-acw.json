    {
        "id": "f847badee93532e4",
        "type": "function",
        "z": "6ec25d0a238955d6",
        "name": "Parse Command & Build MQTT",
        "func": "const id = msg.req.params.id;\nconst payload = msg.payload || {};\nconst dim = parseInt(payload.dim) || 0;\n\nif (!id || isNaN(dim) || dim < 0 || dim > 100) {\n    msg.statusCode = 400;\n    msg.payload = { error: 'Invalid id or dim (0-100)' };\n    return [null, msg];\n}\n\n// === Verifikasi sesi admin sebelum perintah diteruskan ke MQTT/ESP32 ===\n// Mencegah role 'user' (monitoring-only) memanggil endpoint ini langsung lewat API, bukan cuma disembunyikan di UI\nconst token = msg.req.headers['x-acw-token'];\nconst sessions = global.get('acwSessions') || {};\nconst session = token ? sessions[token] : null;\n\nif (!session || session.role !== 'admin' || session.expiresAt < Date.now()) {\n    msg.statusCode = 403;\n    msg.payload = { error: 'Forbidden: hanya admin yang bisa mengubah kecerahan' };\n    return [null, msg];\n}\n\n// Output 1: MQTT publish\nconst mqttMsg = {\n    topic: `iot/lights/${id}/command`,\n    payload: JSON.stringify({ dim: dim }),\n    qos: 1,\n    retain: false\n};\n\n// Output 2: HTTP response (echo back) - pakai msg asli (bukan objek baru) supaya req/res tetap ada\nmsg.payload = { id: id, dim: dim };\n\nreturn [mqttMsg, msg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
