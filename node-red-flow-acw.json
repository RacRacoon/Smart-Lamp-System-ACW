    {
        "id": "login_verify_fn",
        "type": "function",
        "z": "6ec25d0a238955d6",
        "name": "Verify Password & Issue Session",
        "func": "const crypto = global.get('crypto');\n\nfunction verifyPassword(password, stored) {\n    if (!stored || stored.indexOf(':') === -1) return false;\n    const parts = stored.split(':');\n    const salt = parts[0];\n    const hashHex = parts[1];\n    const hashBuffer = Buffer.from(hashHex, 'hex');\n    const derivedKey = crypto.scryptSync(password, salt, 64);\n    if (derivedKey.length !== hashBuffer.length) return false;\n    return crypto.timingSafeEqual(derivedKey, hashBuffer);\n}\n\nconst rows = msg.payload || [];\nconst user = rows[0];\nconst valid = user && verifyPassword(msg.loginPassword, user.password_hash);\n\n// Pesan generik dibuat sama baik username tidak ada maupun password salah,\n// supaya tidak bisa dipakai menebak username mana yang valid (username enumeration)\nif (!valid) {\n    msg.statusCode = 401;\n    msg.payload = { error: 'Username atau password salah' };\n    return msg;\n}\n\nconst role = user.role;\nconst sessions = global.get('acwSessions') || {};\nconst now = Date.now();\nObject.keys(sessions).forEach(t => {\n    if (sessions[t].expiresAt < now) delete sessions[t];\n});\n\nconst token = 'tok_' + now.toString(36) + '_' + Math.random().toString(36).slice(2);\nsessions[token] = { role: role, expiresAt: now + 12 * 60 * 60 * 1000 };\nglobal.set('acwSessions', sessions);\n\nmsg.statusCode = 200;\nmsg.payload = { role: role, token: token };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
